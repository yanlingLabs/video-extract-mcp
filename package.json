{
  "name": "@yanlinglabs/video-extract-mcp",
  "version": "0.9.0",
  "description": "MCP server that turns any video URL into a transcript and a small set of important, deduplicated keyframes — locally, with no cloud APIs. Supports YouTube, TikTok, Facebook, WeChat Channels, direct MP4/HLS and generic sites.",
  "main": "dist/mcp.js",
  "bin": {
    "video-extract-mcp": "dist/mcp.js",
    "video-extract": "dist/cli.js"
  },
  "files": [
    "dist",
    "scripts/fetch-models.sh",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "SKILL.md"
  ],
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "publishConfig": {
    "access": "public"
  },
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "pretest": "npm run build",
    "test": "vitest run",
    "build": "tsc",
    "typecheck": "npm run build && tsc --noEmit -p tsconfig.typecheck.json",
    "preflight": "tsx scripts/preflight.ts",
    "cli": "npm run build && node dist/cli.js",
    "matrix": "tsx scripts/matrix.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "video",
    "transcript",
    "transcription",
    "keyframe",
    "keyframes",
    "frame-extraction",
    "scene-detection",
    "whisper",
    "sense-voice",
    "speech-recognition",
    "asr",
    "yt-dlp",
    "youtube",
    "tiktok",
    "wechat-channels",
    "video-understanding",
    "ai-agent",
    "llm-tools"
  ],
  "author": "yanlingLabs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yanlingLabs/video-extract-mcp.git"
  },
  "homepage": "https://github.com/yanlingLabs/video-extract-mcp#readme",
  "bugs": {
    "url": "https://github.com/yanlingLabs/video-extract-mcp/issues"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "sharp": "^0.35.3",
    "sherpa-onnx-node": "^1.13.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "sharp": "^0.35.3"
  }
}
